<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="https://jakarta.ee/xml/ns/jakartaee" xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd" version="6.0">
  <display-name>ProgettoTecnologie</display-name>
  <servlet>
    <servlet-name>Index</servlet-name>
    <servlet-class>it.ristorante.servlet.Index</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>Index</servlet-name>
    <url-pattern>/index</url-pattern>
  </servlet-mapping>
  <welcome-file-list>
    <welcome-file>/WEB-INF/index.jsp</welcome-file>
  </welcome-file-list>
  <servlet>
    <servlet-name>RichiestaLogin</servlet-name>
    <servlet-class>it.ristorante.servlet.RichiestaLogin</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>RichiestaLogin</servlet-name>
    <url-pattern>/richiestaLogin</url-pattern>
  </servlet-mapping>
  <servlet>
    <servlet-name>Login</servlet-name>
    <servlet-class>it.ristorante.servlet.privato.Login</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>Login</servlet-name>
    <url-pattern>/login</url-pattern>
  </servlet-mapping>
  <servlet>
    <description></description>
    <display-name>AreaPrivata</display-name>
    <servlet-name>AreaPrivata</servlet-name>
    <servlet-class>it.ristorante.servlet.privato.AreaPrivata</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>AreaPrivata</servlet-name>
    <url-pattern>/privato/AreaPrivata</url-pattern>
  </servlet-mapping>

  <!--
    Nota: Logout, GestioneMenu, EliminaPiatto, VisualizzaOrdini, AggiungiPiatto e
    AggiungiPersonale sono gia' registrate tramite l'annotazione @WebServlet
    direttamente nella loro classe Java (es. "/privato/GestioneMenu"), quindi non
    serve (ed e' sbagliato) ripeterle qui con un url-pattern diverso.
    Le voci "Ordine" (puntava a un semplice Bean, non a una Servlet) e
    "InviaPrenotazione" (la classe non esiste nel progetto) sono state rimosse
    perche' non funzionanti.
  -->

  <!--
    Configurazione del cookie di sessione (JSESSIONID) usato per il login.
    - session-timeout: dopo 30 minuti di inattività la sessione (e quindi il login) scade automaticamente.
    - http-only: impedisce a JavaScript lato client di leggere il cookie di sessione,
      proteggendo il JSESSIONID da furti tramite attacchi XSS (Session Hijacking).
  -->
  <session-config>
    <session-timeout>30</session-timeout>
    <cookie-config>
      <http-only>true</http-only>
    </cookie-config>
  </session-config>
</web-app>
